{
  "name": "WhatsAppBotControl",
  "type": "object",
  "properties": {
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df (\u05de\u05e0\u05d5\u05e8\u05de\u05dc)"
    },
    "mode": {
      "type": "string",
      "enum": [
        "paused",
        "active_managed"
      ],
      "description": "\u05de\u05e6\u05d1 \u05d4\u05d1\u05d5\u05d8 \u05dc\u05de\u05e1\u05e4\u05e8: paused=\u05de\u05d5\u05e9\u05d4\u05d4 (\u05d4\u05d1\u05d5\u05d8 \u05e9\u05d5\u05ea\u05e7), active_managed=\u05de\u05e0\u05d5\u05d4\u05dc \u05d9\u05d3\u05e0\u05d9\u05ea (\u05d1\u05d5\u05d8 \u05e4\u05e2\u05d9\u05dc, \u05dc\u05d0 \u05de\u05d5\u05e9\u05d4\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05db\u05e9\u05dc\u05d9\u05d0\u05ea \u05e9\u05d5\u05dc\u05d7\u05ea)"
    },
    "set_by": {
      "type": "string",
      "enum": [
        "auto",
        "human"
      ],
      "description": "\u05de\u05d9 \u05e7\u05d1\u05e2: auto=\u05d6\u05d5\u05d4\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea \u05de\u05e9\u05dc\u05d9\u05d7\u05d4 \u05d9\u05d3\u05e0\u05d9\u05ea \u05e9\u05dc \u05dc\u05d9\u05d0\u05ea, human=\u05d4\u05d5\u05d2\u05d3\u05e8 \u05d9\u05d3\u05e0\u05d9\u05ea \u05de\u05d4\u05d3\u05e9\u05d1\u05d5\u05e8\u05d3/\u05d4\u05e1\u05d5\u05db\u05df"
    },
    "note": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea"
    }
  },
  "required": [
    "phone",
    "mode"
  ]
}