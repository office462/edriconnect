{
  "name": "\u05d8\u05e8\u05d9\u05d2\u05e8 \u05e9\u05d9\u05e0\u05d5\u05d9 \u05e1\u05d8\u05d8\u05d5\u05e1 \u05e4\u05e0\u05d9\u05d9\u05d4",
  "description": "\u05de\u05d0\u05d6\u05d9\u05df \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05e1\u05d8\u05d8\u05d5\u05e1 \u05d1\u05e4\u05e0\u05d9\u05d5\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea - \u05de\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d4\u05d1\u05d5\u05d8 \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d1\u05ea\u05d4\u05dc\u05d9\u05da \u05db\u05e9\u05e1\u05d8\u05d8\u05d5\u05e1 \u05de\u05e9\u05ea\u05e0\u05d4 (paid, in_review, scheduled)",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"status\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ServiceRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "migrated_workflow",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onServiceRequestUpdate",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onServiceRequestUpdate"
  }
}